#!/bin/bash

{ # this ensures the entire script is downloaded #

# kubernetes
KUBE_VERSION="1.27.0"
KUBE_RELEASE="00"
KUBE_ADM_CONFIG_FILE="/etc/systemd/system/kubelet.service.d/10-kubeadm.conf"
KUBE_POD_NETWORK="10.250.0.0/16"
KUBE_SVC_NETWORK="10.251.0.0/16"

# kubernetes internal ip
KUBE_INT_NET="10.152.0.0/24"
KUBE_MASTER=10.152.0.2
KUBE_WORKER_1=10.152.0.3
KUBE_WORKER_2=10.152.0.4
KUBE_WORKER_3=10.152.0.5

# pdsh environment variables
PDSH_RCMD_TYPE=ssh
PDSH_SSH_ARGS_APPEND="-o StrictHostKeyChecking=no"
PDSH_CONNECTION=($SSH_CONNECTION)

# calico
CALICO_VERSION="3.25.1"

# longhorn
LONGHORN_VERSION="1.4.1"

# ingress nginx
CLOUD_LB_NAME="frontend"
CLOUD_LB_HTTP=32554
CLOUD_LB_HTTPS=31006

# caddy
CADDY_ROOT_DOMAIN=dev.kuanhong.org
CADDY_SUBDOMAIN=git
CADDY_ACME_EMAIL=admin@dev.kuanhong.org

# letsencrypt endpoint
LE_ENDPOINT=acme-staging-v02.api.letsencrypt.org
#LE_ENDPOINT=acme-v02.api.letsencrypt.org

# cloudflare
CLOUDFLARE_API_TOKEN=test

# mysql
MYSQL_ROOT_PASSWORD='password'
MYSQL_GITEA_USER='gitea'
MYSQL_GITEA_PASSWORD='gitea'
MYSQL_GITEA_DB='giteadb'

# gitea setup
GITEA_SERVICE_ACCOUNT='gitea'
GITEA_REPO_VOL='/mnt/HC_VOL/repo'
GITEA_REPO_PATH='/home/gitea/repo'
GITEA_BINARY_URL='https://dl.gitea.com/gitea/1.19.0/gitea-1.19.0-linux-amd64'
GITEA_SITE_NAME='Codec'
GITEA_DOMAIN=${CADDY_SUBDOMAIN}.${CADDY_ROOT_DOMAIN}
GITEA_PORT='3000'

# gitea smtp
GITEA_SMTP_HOST='email-smtp.ap-southeast-1.amazonaws.com:587'
GITEA_SMTP_FROM=''
GITEA_SMTP_USER=''
GITEA_SMTP_PASS=''
GITEA_SMTP_SUBJECT_PREFIX='[Gitea] '

# gitea features
GITEA_NOREPLY_ADD=${CADDY_SUBDOMAIN}.${CADDY_ROOT_DOMAIN}
GITEA_SWAGGER='false'
GITEA_DISABLE_GRAVATAR='true'
GITEA_ENABLE_LIBRAVATAR='false'

# gitea admin user
GITEA_ADMIN_USERNAME='administrator'
GITEA_ADMIN_EMAIL='admin@dev.kuanhong.org'

} # this ensures the entire script is downloaded #