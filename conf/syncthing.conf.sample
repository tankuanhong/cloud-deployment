#!/bin/bash

{ # this ensures the entire script is downloaded #

# syncthing
ST_DISCOSRV_BINARY_URL="https://github.com/syncthing/discosrv/releases/download/v1.23.4/stdiscosrv-linux-amd64-v1.23.4.tar.gz"
ST_DISCOSRV_PUBLIC_ADDR="disco.staging.kuanhong.org"
ST_RELAYSRV_BINARY_URL="https://github.com/syncthing/relaysrv/releases/download/v1.22.1/strelaysrv-linux-amd64-v1.22.1.tar.gz"
ST_RELAYSRV_PUBLIC_ADDR=""

# caddy
CADDY_ROOT_DOMAIN=dev.kuanhong.org
CADDY_SUBDOMAIN=wiki
CADDY_ACME_EMAIL=admin@dev.kuanhong.org

# letsencrypt endpoint
LE_ENDPOINT=acme-staging-v02.api.letsencrypt.org
#LE_ENDPOINT=acme-v02.api.letsencrypt.org

# cloudflare
CLOUDFLARE_API_TOKEN=test

# dokuwiki setup
DOKUWIKI_DOMAIN=${CADDY_SUBDOMAIN}.${CADDY_ROOT_DOMAIN}

} # this ensures the entire script is downloaded #