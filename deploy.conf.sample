#!/bin/bash

{ # this ensures the entire script is downloaded #

# log library
LOGGER_LEVEL=0
LOGGER_ERROR_TRACE=0
LOGGER_STDERR_LEVEL=4
LOGGER_COLOR=auto
LOGGER_TARGET=deploy.log

# ssh
SSH_PORT=59222

# logdna
LOGDNA_KEY="test"

# caddy
CADDY_ROOT_DOMAIN=dev.kuanhong.org
CADDY_SUBDOMAIN=console
CADDY_ACME_EMAIL=admin@dev.kuanhong.org
CADDY_BACKEND=${CADDY_SUBDOMAIN}-be.${CADDY_ROOT_DOMAIN}

# teleport
TELEPORT_CLUSTER=Playground
TELEPORT_AUTH_PORT=3025
TELEPORT_PROXY_PORT=3080
TELEPORT_PUBLIC_ADDR=${CADDY_SUBDOMAIN}.${CADDY_ROOT_DOMAIN}

# letsencrypt endpoint
LE_ENDPOINT=acme-staging-v02.api.letsencrypt.org
#LE_ENDPOINT=acme-v02.api.letsencrypt.org

# cloudflare
CLOUDFLARE_API_TOKEN=test

# kopia
KOPIA_SUBDOMAIN=console-backup
KOPIA_PUBLIC_ADDR=${KOPIA_SUBDOMAIN}.${CADDY_ROOT_DOMAIN}
KOPIA_BACKEND=${KOPIA_SUBDOMAIN}-be.${CADDY_ROOT_DOMAIN}

} # this ensures the entire script is downloaded #