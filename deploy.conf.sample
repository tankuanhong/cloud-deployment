#!/bin/bash

{ # this ensures the entire script is downloaded #

# log library
LOGGER_LEVEL=0
LOGGER_ERROR_TRACE=0
LOGGER_STDERR_LEVEL=4
LOGGER_COLOR=auto
LOGGER_TARGET=deploy.log

# ssh
SSH_PORT=59222

# logdna
LOGDNA_KEY="test"

# teleport
TELEPORT_CLUSTER=Playground
TELEPORT_AUTH_PORT=3025
TELEPORT_PROXY_PORT=3080
TELEPORT_PUBLIC_ADDR=console.example.com

# caddy
CADDY_ACME_EMAIL=admin@example.com
CADDY_ROOT_DOMAIN=example.com

# cloudflare
CLOUDFLARE_API_TOKEN=test

} # this ensures the entire script is downloaded #