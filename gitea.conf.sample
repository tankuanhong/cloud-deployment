#!/bin/bash

{ # this ensures the entire script is downloaded #

# mysql
MYSQL_ROOT_PASSWORD='password'
MYSQL_GITEA_USER='gitea'
MYSQL_GITEA_PASSWORD='gitea'
MYSQL_GITEA_DB='giteadb'

# gitea setup
GITEA_SERVICE_ACCOUNT='gitea'
GITEA_REPO_VOL='/mnt/HC_VOL/repo'
GITEA_REPO_PATH='/home/gitea/repo'
GITEA_BINARY_URL='https://dl.gitea.com/gitea/1.19.0/gitea-1.19.0-linux-amd64'
GITEA_SITE_NAME='Codec'
GITEA_DOMAIN='git.dev.kuanhong.org'
GITEA_PORT='3000'

# gitea smtp
GITEA_SMTP_HOST='email-smtp.ap-southeast-1.amazonaws.com:587'
GITEA_SMTP_FROM=''
GITEA_SMTP_USER=''
GITEA_SMTP_PASS=''
GITEA_SMTP_SUBJECT_PREFIX='[Gitea] '

# gitea features
GITEA_NOREPLY_ADD='git.dev.kuanhong.org'
GITEA_SWAGGER='false'
GITEA_DISABLE_GRAVATAR='true'
GITEA_ENABLE_LIBRAVATAR='false'



} # this ensures the entire script is downloaded #