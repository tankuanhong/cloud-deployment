MAILTO=""
backup_time=$(date "+%y%m%d_%H%M%S")
backup_dir=${TELEPORT_BACKUP_DIR}/${backup_time}_partial
15 * * * *    cp /etc/teleport.yaml ${backup_dir}/teleport_conf.yaml && /usr/local/bin/tctl get all --with-secrets > ${backup_dir}/teleport_state.yaml && cp /etc/caddy/caddy.json ${backup_dir}/caddy.json
